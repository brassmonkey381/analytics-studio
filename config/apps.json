    {
      "id": "michi-maker",
      "name": "Michi-Maker",
      "projectRef": "piikwvntldytjejxmcla",
      "serviceKeyEnv": "TCG_APP_SERVICE_KEY",
      "metricsSqlFile": "michi-maker.metrics.sql",
      "coverageSqlFile": "shared-app-coverage.sql",
      "totalsLabel": "signed-in accounts with activity",
      "totalsSqlFile": "michi-maker.totals.sql",
      "cohortFromActivity": true,
      "newUsers": null,
      "reportNote": "Shares one auth pool with TCGScan, which has only 10 real accounts total — the rest of auth.users is anonymous guest sessions, one per guest visit. DAU and new users count signed-in accounts only; guest sessions are shown separately and are closer to device-visits than people. Activity is write-based (binder edits, slices, likes, prints), so browsing leaves no trace.",
