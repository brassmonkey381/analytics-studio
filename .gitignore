.env
node_modules/
logs/

# Contains real users' email addresses. metrics.json stays counts-only and IS
# committed as the historical record; these two carry PII and must not enter
# git history, where removing them would mean rewriting it.
data/accounts.json
reports/report.html
reports/latest.md

# Events lane. journeys.json is per-session timelines keyed by account email;
# events.html renders them. data/events.json and reports/events.md stay
# counts-only and ARE committed.
data/journeys.json
reports/events.html

# Daily digest email. Its whole point is naming the accounts behind each number, so the
# rendered email is PII by construction and never enters git. The recipient address and the
# Resend key live in .env for the same reason - an email address is identity.
state/

# Print/QR campaign lane. campaigns-roster.json names who arrived on each printed
# code; campaigns.html renders them. data/campaigns.json stays counts-only and IS
# committed, and so is reports/campaigns.md — marketing-studio reads that file, and
# a campaign code is a value we print on our own paper, not identity.
data/campaigns-roster.json
reports/campaigns.html

# Plans lane. plans-roster.json names the account at each tier; plans.html
# renders it. data/plans.json stays counts-only and IS committed.
data/plans-roster.json
reports/plans.html

# Shares lane. shares-roster.json names the visitors; shares.html renders them.
data/shares-roster.json
reports/shares.html

# Usage lane. usage-roster.json names who made each binder/scan/card; usage.html
# renders them plus the per-user credit table. data/usage.json stays counts-only
# and IS committed.
data/usage-roster.json
reports/usage.html

# Economy lane. economy-roster.json names the account behind every balance,
# every flow bucket and every cap meter; economy.html renders them.
# data/economy.json stays counts-only and IS committed.
data/economy-roster.json
reports/economy.html

# Geo lane (includes the enrichment-debt board). geo-roster.json carries
# place/venue names for the hover layer; geo.html renders them. data/geo.json
# stays counts-only and IS committed, and so is data/enrich.json — counts-only
# HISTORY (one row per day) that cannot be regenerated once days pass.
data/geo-roster.json
reports/geo.html

# New-user geography lane. newuser-geo-roster.json puts a city beside each new
# account's id stub, and a person's city is identity. data/newuser-geo.json
# stays counts-by-city only and IS committed. No report HTML: the digest reads it.
data/newuser-geo-roster.json

# Wishlist lane. wishlist-roster.json names every voter and carries the ideas people
# wrote in the box (prose and email are identity). data/wishlist.json is counts only.
data/wishlist-roster.json

# Reddit lane. reddit-roster.json names who arrived from each ad and what they became;
# reddit.html renders them. data/reddit.json and reports/reddit.md stay counts-only and ARE
# committed (marketing-studio reads the md).
data/reddit-roster.json
reports/reddit.html
