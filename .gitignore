.env
node_modules/
logs/

# Contains real users' email addresses. metrics.json stays counts-only and IS
# committed as the historical record; these two carry PII and must not enter
# git history, where removing them would mean rewriting it.
data/accounts.json
reports/report.html
reports/latest.md

# Events lane. journeys.json is per-session timelines keyed by account email;
# events.html renders them. data/events.json and reports/events.md stay
# counts-only and ARE committed.
data/journeys.json
reports/events.html

# Plans lane. plans-roster.json names the account at each tier; plans.html
# renders it. data/plans.json stays counts-only and IS committed.
data/plans-roster.json
reports/plans.html

# Shares lane. shares-roster.json names the visitors; shares.html renders them.
data/shares-roster.json
reports/shares.html

# Usage lane. usage-roster.json names who made each binder/scan/card; usage.html
# renders them plus the per-user credit table. data/usage.json stays counts-only
# and IS committed.
data/usage-roster.json
reports/usage.html

# Geo lane. geo-roster.json carries place/venue names for the hover layer;
# geo.html renders them. data/geo.json stays counts-only and IS committed.
data/geo-roster.json
reports/geo.html

# Enrichment-debt lane. enrich-roster.json carries sample place/venue names;
# enrich.html renders them. data/enrich.json is counts-only HISTORY (one row
# per day) and IS committed — it cannot be regenerated once days pass.
data/enrich-roster.json
reports/enrich.html
