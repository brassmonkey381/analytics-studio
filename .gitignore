.env
node_modules/
logs/

# Contains real users' email addresses. metrics.json stays counts-only and IS
# committed as the historical record; these two carry PII and must not enter
# git history, where removing them would mean rewriting it.
data/accounts.json
reports/report.html
reports/latest.md

# Events lane. journeys.json is per-session timelines keyed by account email;
# events.html renders them. data/events.json and reports/events.md stay
# counts-only and ARE committed.
data/journeys.json
reports/events.html

# Plans lane. plans-roster.json names the account at each tier; plans.html
# renders it. data/plans.json stays counts-only and IS committed.
data/plans-roster.json
reports/plans.html

# Shares lane. shares-roster.json names the visitors; shares.html renders them.
data/shares-roster.json
reports/shares.html
