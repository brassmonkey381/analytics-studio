# Preferred: Supabase personal access token (supabase login / dashboard account tokens).
SUPABASE_ACCESS_TOKEN=

# Comma-separated IPs whose ANONYMOUS GUEST traffic is excluded (dev boxes, CI
# runners). Location data, so it lives here and not in committed config.
EXCLUDED_IPS=

# Per-project fallback keys (REST mode; used only when no access token is set).
DOGGLE_SERVICE_KEY=
PICKLEAGUE_SERVICE_KEY=
TCG_APP_SERVICE_KEY=
